<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070a"
    android:padding="14dp"
    android:orientation="vertical"
    android:gravity="center_vertical">

    <!-- Üst Başlık -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚀 ANKA HIZLI ERİŞİM"
        android:textColor="#00e5ff"
        android:textSize="11sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1a2634"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />

    <!-- Durum Mesajı -->
    <TextView
        android:id="@+id/widget_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Genel Sohbet Aktif 💬"
        android:textColor="#ffffff"
        android:textSize="12sp"
        android:paddingBottom="6dp" />

    <!-- Tıklama / Siteye Git Hissi Veren Alan -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[ Siteye Gitmek İçin Dokun ]"
        android:textColor="#38bdf8"
        android:textSize="10sp"
        android:textStyle="italic" />

</LinearLayout>
