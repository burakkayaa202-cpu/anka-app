<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070a"
    android:padding="14dp"
    android:orientation="vertical">

    <!-- Üst Başlık ve Durum -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👑 ANKA LİDERLİK"
            android:textColor="#00e5ff"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 Yükleniyor..."
            android:textColor="#ff9900"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1a2634"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />

    <!-- 1. Sıra -->
    <TextView
        android:id="@+id/rank_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. 🥇 Bağlantı bekleniyor..."
        android:textColor="#ffffff"
        android:textSize="11sp"
        android:paddingBottom="3dp" />

    <!-- 2. Sıra -->
    <TextView
        android:id="@+id/rank_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. 🥈 Veri bekleniyor..."
        android:textColor="#b0c4de"
        android:textSize="11sp"
        android:paddingBottom="3dp" />

    <!-- 3. Sıra -->
    <TextView
        android:id="@+id/rank_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. 🥉 Veri bekleniyor..."
        android:textColor="#a0a0a0"
        android:textSize="11sp" />

</LinearLayout>
